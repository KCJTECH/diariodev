// Diário Dev ITS — schema do banco de dados
// Fonte oficial de verdade. UUIDs internos; chaves públicas legíveis onde o
// frontend depende delas (public_key/slug). Ver docs/BANCO_DE_DADOS.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── enums ────────────────────────────────────────────────────────────────
// Valores internos em maiúsculas; o mapper de assets/data.js converte para os
// textos exibidos ('baixa'|'média'|'alta', 'dev'|'gestor'|'ceo').

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum AccessLevel {
  DEV
  GESTOR
  CEO
}

enum AttachmentStatus {
  PENDING
  CLEAN
  QUARANTINED
  DELETED
}

enum IntegrationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  DEAD
}

// ── usuários e sessão ────────────────────────────────────────────────────

model User {
  id                String      @id @default(uuid()) @db.Uuid
  publicKey         String      @unique @map("public_key")
  name              String
  roleTitle         String      @map("role_title")
  email             String      @unique
  passwordHash      String      @map("password_hash")
  initials          String
  color             String
  active            Boolean     @default(true)
  effectiveLevel    AccessLevel @default(DEV) @map("effective_level")
  timezone          String      @default("America/Sao_Paulo")
  lastLoginAt       DateTime?   @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?   @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  preferences        UserPreference?
  activities         Activity[]
  createdProjects    Project[]           @relation("ProjectCreatedBy")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreatedBy")
  completedTasks     Task[]              @relation("TaskCompletedBy")
  uploadedAttachment Attachment[]
  groupMemberships   GroupMember[]
  sessions           Session[]
  auditLogs          AuditLog[]

  @@index([active])
  @@index([effectiveLevel])
  @@map("users")
}

model UserPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  collapsed        Boolean  @default(false)
  density          String   @default("confortável")
  defaultProjectId String?  @map("default_project_id") @db.Uuid
  themePreference  String   @default("light") @map("theme_preference")
  extraPreferences Json     @default("{}") @map("extra_preferences")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultProject Project? @relation(fields: [defaultProjectId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipHash           String?   @map("ip_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── categorias, projetos ─────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  color       String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  activities Activity[]
  tasks      Task[]

  // Nome único apenas entre categorias ativas: garantido por índice parcial
  // criado via migration SQL (ver migrations). Aqui mantemos o slug único.
  @@index([active])
  @@map("categories")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  creator            User?            @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  activities         Activity[]
  tasks              Task[]
  defaultForUsers    UserPreference[]

  @@index([active])
  @@map("projects")
}

// ── atividades e anexos ──────────────────────────────────────────────────

model Activity {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  categoryNameSnapshot String    @map("category_name_snapshot")
  title                String
  description          String?
  occurredAt           DateTime  @map("occurred_at") @db.Timestamptz(6)
  durationMinutes      Int?      @map("duration_minutes")
  priority             Priority  @default(MEDIA)
  tags                 String[]  @default([])
  sourceTaskId         String?   @map("source_task_id") @db.Uuid
  clientMutationId     String?   @map("client_mutation_id")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id])
  project     Project      @relation(fields: [projectId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  sourceTask  Task?        @relation("TaskSourceActivity", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  completesTask Task?      @relation("TaskCompletionActivity")

  @@unique([userId, clientMutationId], name: "uniq_activity_client_mutation")
  @@index([userId])
  @@index([projectId])
  @@index([categoryId])
  @@index([occurredAt])
  @@index([createdAt])
  @@map("activities")
}

model Attachment {
  id               String           @id @default(uuid()) @db.Uuid
  activityId       String           @map("activity_id") @db.Uuid
  originalName     String           @map("original_name")
  storageProvider  String           @map("storage_provider")
  storageKey       String           @map("storage_key")
  mimeType         String           @map("mime_type")
  detectedMimeType String?          @map("detected_mime_type")
  sizeBytes        BigInt           @map("size_bytes")
  checksum         String
  uploadedBy       String           @map("uploaded_by") @db.Uuid
  status           AttachmentStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  @@index([activityId])
  @@map("attachments")
}

// ── tarefas planejadas ───────────────────────────────────────────────────

model Task {
  id                   String    @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  projectId            String    @map("project_id") @db.Uuid
  assigneeId           String?   @map("assignee_id") @db.Uuid
  createdBy            String    @map("created_by") @db.Uuid
  dueDate              DateTime? @map("due_date") @db.Date
  priority             Priority  @default(MEDIA)
  categoryId           String?   @map("category_id") @db.Uuid
  categoryNameSnapshot String?   @map("category_name_snapshot")
  done                 Boolean   @default(false)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy          String?   @map("completed_by") @db.Uuid
  completionActivityId String?   @unique @map("completion_activity_id") @db.Uuid
  clientMutationId     String?   @map("client_mutation_id")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  project            Project    @relation(fields: [projectId], references: [id])
  assignee           User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator            User       @relation("TaskCreatedBy", fields: [createdBy], references: [id])
  completedByUser    User?      @relation("TaskCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  category           Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completionActivity Activity?  @relation("TaskCompletionActivity", fields: [completionActivityId], references: [id], onDelete: SetNull)
  originatedActivities Activity[] @relation("TaskSourceActivity")

  @@index([assigneeId])
  @@index([projectId])
  @@index([dueDate])
  @@index([done])
  @@map("tasks")
}

// ── grupos de acesso ─────────────────────────────────────────────────────

model AccessGroup {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  level       AccessLevel   @default(DEV)
  permissions String[]      @default([])
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)

  members GroupMember[]

  @@map("access_groups")
}

model GroupMember {
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ── integrações e webhooks ───────────────────────────────────────────────

model Integration {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  abbreviation    String?
  type            String
  enabled         Boolean   @default(true)
  endpoint        String?
  encryptedSecret String?   @map("encrypted_secret")
  events          String[]  @default([])
  notes           String?
  timeoutMs       Int       @default(10000) @map("timeout_ms")
  maxAttempts     Int       @default(5) @map("max_attempts")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  runs IntegrationRun[]

  @@map("integrations")
}

model IntegrationRun {
  id              String               @id @default(uuid()) @db.Uuid
  integrationId   String               @map("integration_id") @db.Uuid
  eventId         String?              @map("event_id") @db.Uuid
  eventName       String               @map("event_name")
  payload         Json
  attempt         Int                  @default(1)
  status          IntegrationRunStatus @default(PENDING)
  httpStatus      Int?                 @map("http_status")
  responseExcerpt String?              @map("response_excerpt")
  errorCode       String?              @map("error_code")
  errorMessage    String?              @map("error_message")
  durationMs      Int?                 @map("duration_ms")
  nextRetryAt     DateTime?            @map("next_retry_at") @db.Timestamptz(6)
  startedAt       DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?            @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
  @@map("integration_runs")
}

// ── configurações globais e auditoria ────────────────────────────────────

model AppSetting {
  id                   String   @id @default(uuid()) @db.Uuid
  brand                Json     @default("{}")
  appearance           Json     @default("{}")
  defaultTheme         String   @default("light") @map("default_theme")
  defaultDensity       String   @default("confortável") @map("default_density")
  organizationTimezone String   @default("America/Sao_Paulo") @map("organization_timezone")
  version              Int      @default(1)
  updatedBy            String?  @map("updated_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  requestId   String?  @map("request_id")
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType])
  @@index([entityId])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  sequence      BigInt    @unique @default(autoincrement())
  eventName     String    @map("event_name")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  scope         Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([publishedAt])
  @@index([createdAt])
  @@map("outbox_events")
}
