# ─────────────────────────────────────────────────────────────
# Diário Dev ITS — variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env real. Não coloque segredos neste arquivo de exemplo.
# ─────────────────────────────────────────────────────────────

# Ambiente: development | test | production
NODE_ENV=development

# Porta da API HTTP
PORT=3333

# Conexão PostgreSQL (banco já existente informado pelo responsável).
# Use um usuário de banco com privilégios mínimos, NUNCA o superusuário.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=postgresql://diariodev:CHANGE_ME@localhost:5432/diariodev?schema=public

# Conexão Redis (Socket.IO adapter, filas BullMQ, locks de job)
REDIS_URL=redis://localhost:6379

# Origem do frontend permitida para CORS e validação de Origin.
# Em produção, informe a origem real (ex.: https://diariodev.itscs.com.br).
APP_ORIGIN=http://localhost:8080

# Segredos de assinatura. Gere valores fortes e únicos por ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_long_random_value
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_long_random_value

# Chave mestra para criptografar segredos de integração (AES-256-GCM).
# Deve ter 32 bytes em base64 (44 chars). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_32_bytes_base64

# Duração dos tokens
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600

# Armazenamento de anexos: local | s3
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# S3/MinIO (apenas quando STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# SMTP (reset de senha; opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Fuso horário da organização
ORGANIZATION_TIMEZONE=America/Sao_Paulo

# Login de protótipo ("entrar como"). SOMENTE em desenvolvimento.
# Em produção deve permanecer false; os endpoints retornam 404.
ALLOW_DEV_LOGIN=true

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Limites de upload
MAX_UPLOAD_BYTES=10485760
MAX_ATTACHMENTS_PER_ACTIVITY=10

# Horário do resumo diário (HH:mm no fuso da organização)
DAILY_SUMMARY_TIME=18:30

# TLS na conexão SMTP: true para porta 465; em 587 use false (STARTTLS).
SMTP_SECURE=false
# Remetente dos e-mails do sistema. Se vazio, usa SMTP_USER.
MAIL_FROM=
# Validade do link de redefinição de senha, em minutos.
PASSWORD_RESET_TTL_MINUTES=60
# Contas cujo e-mail cadastrado nao e uma caixa que alguem le (conta de sistema).
# Para elas o link de redefinicao vai para os gestores ativos, que repassam ao
# responsavel. Lista separada por virgula; vazio = nenhuma.
PASSWORD_RESET_VIA_GESTOR=
