# Dependencias e build
**/node_modules/
dist/
backend/dist/

# Ambiente e segredos (NUNCA versionar)
.env
.env.*
!.env.example
# Variaveis do deploy.sh (contem AI_API_KEY). O padrao .env.* acima NAO pega este
# nome, porque o arquivo se chama deploy.env e nao .env.deploy.
deploy.env
!deploy.env.example

# Logs e artefatos de runtime
logs/
*.log
backend/storage/
backend/logs/
backend/test-results/
backend/playwright-report/
backend/coverage/
backend/.playwright/
backend/prisma/*.db
backend/tests/e2e/*-snapshots/*.tmp.png
uploads/
.thumbnail

# Sistema operacional / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Pacotes locais
*.tgz

# Artefatos do deploy.sh
backend/.dist-prev/
repositorio/

# artefato de hook (sobrescrito a cada fim de sessao)
.planning/
